#!/bin/bash
# Pack a database dump and the data directory (uploaded files, without caches) and
# upload them to the Railway bucket. Keyed by weekday: the bucket always holds the
# last 7 nightly backups. Run it by hand (railway ssh) before risky changes.
set -euo pipefail

f=/tmp/moodle-$(date -u +%a).tar.gz
tmp=$(mktemp -d)
trap 'rm -rf "$f" "$tmp"' EXIT

pg_dump -Fc -f "$tmp/database.dump"  # reads the PG* variables
tar -czf "$f" -C "$tmp" database.dump -C /var \
  --exclude=moodledata/cache --exclude=moodledata/localcache --exclude=moodledata/sessions \
  --exclude=moodledata/temp --exclude=moodledata/trashdir --exclude=moodledata/lock \
  --exclude=moodledata/climaintenance.html moodledata
# Railway buckets are virtual-hosted style: https://<bucket>.<endpoint host>/<key>
curl -fsS --aws-sigv4 "aws:amz:${S3_REGION:-auto}:s3" \
  -u "$S3_ACCESS_KEY_ID:$S3_SECRET_ACCESS_KEY" \
  -T "$f" "https://$S3_BUCKET.${S3_ENDPOINT#https://}/${f##*/}"
echo "moodle-backup: uploaded ${f##*/} ($(du -h "$f" | cut -f1))"
